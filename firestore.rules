rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /{section}/{postId} {
   allow read: if section in ['news','events','dungeons','ranks'];
   allow create, update, delete: if section in ['news','events','dungeons','ranks'] && request.auth != null && request.auth.uid == 'REPLACE_WITH_OWNER_UID';
  }
 }
}
