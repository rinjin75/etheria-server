rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /posts/{allPaths=**} {
   allow read: if true;
   allow write: if request.auth != null && request.auth.uid == 'REPLACE_WITH_OWNER_UID' && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
  }
 }
}
